case 'academy': container.innerHTML = renderAcademy(t); break;
case 'dashboard': container.innerHTML = renderDashboard(t); break;
case 'library': container.innerHTML = renderLibrary(t); break;
case 'questions': container.innerHTML = renderQuestions(t); break;
case 'flashcards': container.innerHTML = renderFlashcards(t); break;
case 'community': container.innerHTML = renderCommunity(t); break;
case 'subject-detail': container.innerHTML = renderSubjectDetail(t, state.selectedSubject); break;
case 'admin': container.innerHTML = renderAdmin(t); break;
