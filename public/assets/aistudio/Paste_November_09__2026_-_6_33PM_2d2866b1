render();
window.scrollTo({ top: 0, behavior: 'smooth' });
}
function toggleLang() {
state.lang = state.lang === 'en' ? 'ar' : 'en';
const html = document.documentElement;
html.lang = state.lang;
html.dir = state.lang === 'ar' ? 'rtl' : 'ltr';
render();
}
// --- RENDER ENGINE ---
function render() {
const container = document.getElementById('app-container');
const t = state.lang === 'ar' ? translations.ar : translations.en;
// Update Branding & Title
document.getElementById('brand-title').innerText = state.lang === 'ar' ? state.brand.nameAr : state.brand.nameEn;
document.getElementById('page-title').innerText = ⁠${state.lang === 'ar' ? state.brand.nameAr : state.brand.nameEn} — Digital Medical University⁠;
document.getElementById('footer-text').innerText = ⁠${state.lang === 'ar' ? state.brand.nameAr : state.brand.nameEn} — ${state.lang === 'ar' ? state.brand.taglineAr : state.brand.taglineEn} 🤍⁠;
// Navigation active state
['home', 'academy', 'dashboard', 'library', 'questions', 'flashcards', 'community', 'admin'].forEach(r => {
