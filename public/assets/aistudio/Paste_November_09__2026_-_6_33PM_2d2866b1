btn.className = state.currentRoute === r
? "px-4 py-2 rounded-full text-sm font-semibold transition bg-primary text-white"
: "px-4 py-2 rounded-full text-sm font-semibold transition text-slate-600 hover:text-slate-900";
}
});
switch(state.currentRoute) {
